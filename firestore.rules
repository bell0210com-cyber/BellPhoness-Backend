rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    // Products: active products are public, admin has full write
    match /products/{productId} {
      allow read: if resource.data.is_active == true || admin();
      allow write: if admin();

      // Product subcollections (e.g. variants, reviews, stock)
      match /{allChildren=**} {
        allow read: if true;
        allow write: if admin();
      }
    }

    // Singular /product/{productId} just in case
    match /product/{productId} {
      allow read: if true;
      allow write: if admin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if admin();
      }
    }

    // Customer Reviews:
    // - Public read for all visitors
    // - Authenticated users can submit reviews for products they purchased
    // - Admins can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.customerUID == request.auth.uid;
      allow update, delete: if admin();
    }

    // Customers collection: used for customer profile storage and real-time profile listeners
    match /customers/{customerId} {
      allow read, create, update: if signedIn() && request.auth.uid == customerId;
      allow read, write: if admin();
    }

    // Users collection (fallback / legacy)
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow read, write: if admin();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if admin();
    }

    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /wishlists/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if admin();
    }

    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}

