rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /products/{productId} { allow read: if resource.data.is_active == true || admin(); allow write: if admin(); }
    match /users/{userId} { allow read, create, update: if signedIn() && request.auth.uid == userId; allow delete: if false; }
    match /orders/{orderId} { allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if false; allow update, delete: if admin(); }
    match /carts/{userId} { allow read, write: if signedIn() && request.auth.uid == userId; }
    match /wishlists/{userId} { allow read, write: if signedIn() && request.auth.uid == userId; }
  }
}
